# ServerHub Environment Configuration
# Copy this file to .env and edit before running docker-compose

# ── App ────────────────────────────────────────────────
APP_NAME=ServerHub

# ── Authentication ─────────────────────────────────────
# Change these before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=serverhub-change-this-secret-in-production

# ── Network ────────────────────────────────────────────
# If running behind a reverse proxy or accessing from another machine,
# set this to the public IP/hostname of your server:
# NEXT_PUBLIC_API_URL=http://your-server-ip:8000

# ── Two-Factor Authentication (2FA) ────────────────────
# All team members added through the UI log in with a 2FA authenticator
# app (Google Authenticator, Authy, etc.) instead of a password.
# QR codes are stored in cloud storage. Choose one backend below.

# Storage backend: "s3bucket" or "cloudinary"
TWOFA_STORAGE=s3bucket

# ── If TWOFA_STORAGE=s3bucket ──────────────────────────
TWOFA_S3_BUCKET=your-bucket-name
TWOFA_S3_ACCESS_KEY=your-aws-access-key-id
TWOFA_S3_SECRET_ACCESS=your-aws-secret-access-key

# ── If TWOFA_STORAGE=cloudinary ────────────────────────
# TWOFA_STORAGE=cloudinary
# TWOFA_CLOUDINARY_CLOUD_NAME=your-cloud-name
# TWOFA_CLOUDINARY_API_KEY=your-api-key
# TWOFA_CLOUDINARY_API_SECRET=your-api-secret
